      "language": "mandarin",
      "sourceClass": "publicHuman",
      "audioSHA256": "efd0f37c756ca8a60bb55dd2d86210bdecc895ac168114fc21c02308884454f5",
      "audioDurationMilliseconds": 6240,
      "audioBytes": 399418,
      "reference": "美国总统乔治·沃克·布什对这一公告表示支持。",
      "protectedExpectations": [],
      "naturalCodeSwitch": false
    },
    {
