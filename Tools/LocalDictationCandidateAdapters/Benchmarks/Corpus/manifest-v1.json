      "audioSHA256": "eba0b68aa12dd62c40f78ea201be03e51f790c1811c8f6b5a646c17a1a9691ed",
      "audioDurationMilliseconds": 4980,
      "audioBytes": 318778,
      "reference": "然后，拉卡·辛格带头唱了拜赞歌。",
      "protectedExpectations": [],
      "naturalCodeSwitch": false
    },
    {
      "id": "cmn_hans_cn-05",
