      "audioDurationMilliseconds": 6360,
      "audioBytes": 407098,
      "reference": "全国各地的著名歌手都唱祈祷歌献给 Shri Shyam。",
      "protectedExpectations": [],
      "naturalCodeSwitch": false
    },
    {
      "id": "cmn_hans_cn-12",
      "sourceFile": "cmn_hans_cn/12-id1639-8647012674971109822.wav",
